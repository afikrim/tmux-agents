FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 tmux procps nodejs locales ca-certificates && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8 TERM=xterm-256color
WORKDIR /work
COPY . .
CMD ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"]
